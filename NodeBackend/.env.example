# Database
DATABASE_URL=your_database_url_here

# WhatsApp Configuration
WHATSAPP_CLIENT_ID=default-client
CHROME_EXECUTABLE_PATH=/usr/bin/chromium-browser

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Development
NODE_ENV=development
DEMO_MODE=false

# Voice service integration
# Generate one strong random value and set the exact same value in:
# 1. this main backend, and 2. VoiceAgentService.
# Example generation:
# powershell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
VOICE_SESSION_TOKEN_SECRET=replace-with-a-long-random-shared-secret

# Used to authenticate VoiceAgentService calls to /api/voice-agent/respond.
# Set the exact same value as PLATFORM_AGENT_SECRET in VoiceAgentService.
VOICE_AGENT_SHARED_SECRET=replace-with-a-different-long-random-shared-secret

# HR Chatbot / Anthropic Claude Configuration
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Private Supabase bucket used to archive every clinical image/document before parsing
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATA_ATTACHMENTS_BUCKET=ocruploads

# DO Functions Base URL (for task management functions)
DO_FUNCTIONS_BASE_URL=https://faas-blr1-8177d592.doserverless.co/api/v1/web/fn-90be8014-1769-44c7-8b81-46179614f63a/default

# HIMS Integration (OPD Bot) — calls HIMS Supabase Edge Functions directly
HIMS_SUPABASE_URL=https://nxbzrpmlnlvknmutyher.supabase.co
HIMS_SUPABASE_ANON_KEY=your-hims-project-anon-key-here
HIMS_BOT_SECRET=your-hims-bot-secret-here

# Browser origins allowed to call this API (comma separated, full origin, no trailing slash).
# localhost:4173 and localhost:5173 are always allowed and do not need listing.
CORS_ORIGINS=https://your-app.example.com,https://www.your-app.example.com

# Public URL of this backend, used to build media links sent to WhatsApp.
PUBLIC_BASE_URL=

# Replit Configuration (auto-populated) — legacy alias for CORS_ORIGINS, prefer CORS_ORIGINS
REPLIT_DOMAINS=

# Meta WhatsApp Cloud API channel (provider = cloud_api sessions)
# App secret of the Meta app (App Dashboard -> App settings -> Basic). Required to accept webhooks.
META_APP_SECRET=
# Any random string; enter the same value in App Dashboard -> WhatsApp -> Configuration -> Verify token.
META_WEBHOOK_VERIFY_TOKEN=
# Optional fallback access token used when a cloud_api session row has no token of its own.
META_WA_ACCESS_TOKEN=
# Optional, default v25.0
META_GRAPH_VERSION=
# Embedded Signup (let other businesses link their own WhatsApp number from the dashboard)
# App id of the Meta app; shown to the browser, not secret.
META_APP_ID=
# Configuration id from App Dashboard -> Facebook Login for Business -> Configurations (WhatsApp Embedded Signup)
META_ES_CONFIG_ID=
